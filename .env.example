# ==============================================================================
# ОБЯЗАТЕЛЬНЫЕ ПЕРЕМЕННЫЕ ОКРУЖЕНИЯ
# ==============================================================================

# Секретный токен для Browserless (используется при запуске через docker-compose)
BROWSERLESS_TOKEN=vfs_secret_token_123

# WebSocket URL для подключения к сервису browserless (CDP)
# В docker-compose формируется автоматически: ws://browserless:3000/chromium?token=${BROWSERLESS_TOKEN}&timeout=86400000
# Пример для внешнего Browserless: ws://host:3000/chromium?token=YOUR_TOKEN&timeout=86400000
BROWSERLESS_WS=ws://browserless:3000/chromium?token=vfs_secret_token_123&timeout=86400000

# API-ключ OpenAI для анализа скриншотов через GPT-4o-mini
OPENAI_API_KEY=sk-proj-...

# Токен Telegram-бота от @BotFather
TG_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Белый список ID чатов Telegram через запятую (кому отправлять алерты и кто может слать команды)
TG_CHAT_IDS=123456789,987654321

# Учетные данные основного аккаунта VFS (куда переключаться при нахождении слота)
# В Coolify для паролей со спецсимволами обязательно включать галочку "Is Literal"
MAIN_EMAIL=applicant@example.com
MAIN_PASSWORD=YourStrongPassword123!

# Список донорских аккаунтов для циклической проверки слотов и защиты от банов (в формате JSON-массива)
DONOR_ACCOUNTS=[{"email":"donor1@example.com","password":"Password1!"},{"email":"donor2@example.com","password":"Password2!"}]

# Данные заявителя (в формате JSON-объекта)
USER_DATA_JSON={"first_name":"Иван","last_name":"Иванов","gender":"Male","dob":"01/01/2000","nationality":"Kazakhstan","passport_number":"N12345678","passport_expiry":"01/01/2030","phone_number":"77011234567","email":"applicant@example.com"}

# ==============================================================================
# НЕОБЯЗАТЕЛЬНЫЕ НАСТРОЙКИ (со значениями по умолчанию)
# ==============================================================================

# Количество кругов проверки на одном доноре до плановой смены аккаунта
ROUNDS_BEFORE_ROTATION=3

# Интервал между кругами проверки в минутах (например 5, 10 или 15 минут)
# Если указан, автоматически рассчитывает паузу между кругами с естественным разбросом +/- 10%
CHECK_INTERVAL_MINUTES=5

# Случайная пауза между полными кругами в секундах (используется, если CHECK_INTERVAL_MINUTES не задан)
ROUND_DELAY_MIN=180
ROUND_DELAY_MAX=300

# Случайная пауза между городами внутри одного круга (в секундах)
CITY_DELAY_MIN=15
CITY_DELAY_MAX=25

# Уровень логирования: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Длительность автоматической паузы после обнаружения слота (в минутах)
SLOT_PAUSE_MINUTES=60

# Внешняя ссылка на Live View / Debugger Browserless (если настроен домен, для ручного ввода в браузере)
# BROWSERLESS_DEBUG_URL=https://browserless.yourdomain.com

# Путь к файлу сохранения состояния бота (индекс донора, статистика)
STATE_FILE_PATH=state.json
